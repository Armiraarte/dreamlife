APP_NAME=Dreamlife
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL publica del backend. El webhook de Mercado Pago queda en APP_URL/api/webhooks/mercadopago
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Base de datos (en Docker el host es "db")
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dream_life
DB_USERNAME=dream
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Origenes permitidos separados por coma (por defecto FRONTEND_URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------
# Mercado Pago (Checkout Pro)
# Usa credenciales de PRUEBA (TEST-...) en desarrollo.
# ---------------------------------------------------------------
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (panel de MP > Webhooks). Recomendado en produccion.
MP_WEBHOOK_SECRET=
# Opcional: URL publica https para notificaciones (si no, APP_URL/api/webhooks/mercadopago)
MP_NOTIFICATION_URL=
MP_CURRENCY=MXN

# ---------------------------------------------------------------
# Firebase (solo se usa el project id para verificar tokens)
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=dreamlifemx

# ---------------------------------------------------------------
# Correo
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dreamlife.mx"
MAIL_FROM_NAME="Dreamlife"
# Copia oculta de cada correo de pedido
MAIL_TO_ADMIN=

# ---------------------------------------------------------------
# Admin inicial (solo lo usa el seeder si ambos estan definidos).
# Despues usa: php artisan admin:create <usuario>
# ---------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=
