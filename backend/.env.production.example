# =================================================================
# DREAMLIFE · PRODUCCION (Hostinger)
# Copia este archivo como .env en el servidor (carpeta de la API) y
# llena los valores marcados con <...>. NUNCA lo subas al repositorio.
# Despues corre: php artisan dreamlife:verificar --correo=<tu correo>
# =================================================================

APP_NAME=Dreamlife
APP_ENV=production
# Genera con: php artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://api.dreamlife.com.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Base de datos MySQL (hPanel > Bases de datos > MySQL) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_dreamlife>
DB_USERNAME=<u123456789_dreamlife>
DB_PASSWORD=<contrasena nueva de la base>

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Frontend / CORS ---
FRONTEND_URL=https://dreamlife.com.mx
CORS_ALLOWED_ORIGINS=https://dreamlife.com.mx,https://www.dreamlife.com.mx

# --- Mercado Pago PRODUCCION ---
# Tus integraciones > (tu app) > Credenciales de produccion > Access Token (APP_USR-...)
MP_ACCESS_TOKEN=<APP_USR-...>
# Tus integraciones > (tu app) > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=<clave secreta del webhook>
MP_NOTIFICATION_URL=https://api.dreamlife.com.mx/api/webhooks/mercadopago
MP_CURRENCY=MXN

# --- Firebase (clientes) ---
FIREBASE_PROJECT_ID=dreamlifemx

# --- Correo (hPanel > Correos > crea no-reply@dreamlife.com.mx) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@dreamlife.com.mx
MAIL_PASSWORD=<contrasena del buzon no-reply>
MAIL_FROM_ADDRESS=no-reply@dreamlife.com.mx
MAIL_FROM_NAME="DREAMLIFE"
# Copia oculta de cada pedido pagado y enviado
MAIL_TO_ADMIN=<tu correo>
