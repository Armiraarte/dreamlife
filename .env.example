# Variables para docker compose. Copia a .env y llena los valores.
# Nunca subas .env a git.

# Genera con: docker compose run --rm --no-deps backend php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Puertos publicados en tu maquina (si el 3000 esta ocupado usa otro y ajusta FRONTEND_URL)
FRONTEND_PORT=3000
API_PORT=8000

# MySQL del contenedor "db"
DB_DATABASE=dream_life
DB_USERNAME=dream
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Mercado Pago: usa el Access Token de PRUEBA (TEST-...) en desarrollo
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

FIREBASE_PROJECT_ID=dreamlifemx

MAIL_FROM_ADDRESS=no-reply@dreamlife.mx
MAIL_TO_ADMIN=

# Admin inicial que crea el seeder en el primer arranque (minimo 10 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=
